{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "debug": false,

  // ---- Turn Protection ----
  "turnProtection": {
    "enabled": true,
    "turns": 4,
  },
  "pruneNotification": "detailed",
  "pruneNotificationType": "chat",

  // ---- Commands ----
  "commands": {
    "enabled": true,
    "protectedTools": [],
  },

  // ---- Strategies ----
  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": [],
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": [],
    },
  },

  // ---- Compression ----
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    "summaryBuffer": true,
    "maxContextLimit": 300000,
    "minContextLimit": 100000,
    "nudgeFrequency": 10,
    "iterationNudgeThreshold": 25,
    "nudgeForce": "strong",
    "protectedTools": ["task", "skill", "todowrite", "todoread"],
    "protectTags": false,
    "protectUserMessages": false,
  },

  // ---- Experimental ----
  "experimental": {
    "customPrompts": true,
  },
}
